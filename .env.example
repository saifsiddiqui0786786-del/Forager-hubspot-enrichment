# Copy this file to .env and fill in the values. Never commit .env.

# Forager - https://app.forager.ai/keys and https://app.forager.ai/profile
FORAGER_API_KEY=
FORAGER_ACCOUNT_ID=

# HubSpot app - access token and client secret (used to verify webhook signatures)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=

# Any long random string. Callers of /enrich and /find-contacts send it as X-API-Key.
SERVICE_API_KEY=

# Optional tuning
DEFAULT_JOB_TITLES=Chief,VP,Vice President,Head of,Director
DEFAULT_CONTACT_LIMIT=5
MAX_CANDIDATES=25
ONLY_COMPLETE_CONTACTS=true
FORAGER_PHONE_QUALITY_TIER=most_coverage
